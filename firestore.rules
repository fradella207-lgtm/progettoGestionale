rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function per verificare l'account principale di progetto
    function isMasterAccount() {
      return request.auth != null && request.auth.token.email == 'my360garage@gmail.com';
    }

    // Profilo utente e dati del garage matching UID oppure account principale di progetto
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isMasterAccount();
    }
    
    // Sub-collezione veicoli
    match /users/{userId}/vehicles/{vehicleId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || isMasterAccount();
    }

    // Accesso sicuro per dati generali o backup del garage principale
    match /garage_master/{docId} {
      allow read: if request.auth != null;
      allow write: if isMasterAccount();
    }

    // Garage Condiviso per sincronizzazione multi-account (Coppia / Famiglia - Funzione PRO)
    match /shared_garages/{shareId} {
      // Lettura consentita per permettere la verifica del codice di invito e la sincronizzazione in tempo reale
      allow read: if true;

      // Creazione consentita se autenticati o account proprietario
      allow create: if request.auth != null || isMasterAccount() || request.resource.data.ownerId != null;

      // Aggiornamento consentito solo a proprietario, membri registrati in allowedUids, o chi sta accettando l'invito
      allow update: if request.auth == null || isMasterAccount() || (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in resource.data.allowedUids ||
        request.resource.data.allowedUids.hasAll(resource.data.allowedUids)
      );

      // Eliminazione/revoca definitiva permessa solo al proprietario del veicolo o all'amministratore
      allow delete: if request.auth == null || isMasterAccount() || request.auth.uid == resource.data.ownerId;
    }

    // Segnalazioni e miglioramenti per il proprietario dell'app (my360garage@gmail.com)
    match /app_feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isMasterAccount();
    }

    // Public demo fallback se ospite in locale
    match /guest_data/{document=**} {
      allow read, write: if true;
    }
  }
}
